{
  "name": "ajax-watcher",
  "version": "2.0.0",
  "description": "轻量级网络请求调试工具，专为移动端/微信等难以调试的环境设计 | Lightweight network request debugger for mobile/WeChat environments",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ajax",
    "network",
    "debugger",
    "mobile",
    "wechat",
    "xhr",
    "fetch",
    "typescript",
    "devtools"
  ],
  "author": "vldh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AJLoveChina/ajax-watcher.git"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.6",
    "vitest": "^1.0.4",
    "jsdom": "^23.0.1"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
